@* @page "/" *@
@page "/login"
@layout AuthLayout

@inject NavigationManager Nav
@inject frontendblazor.Services.AuthApi AuthApi
@inject frontendblazor.Services.TokenStorage TokenStorage
@inject frontendblazor.Services.ApiAuthStateProvider AuthState

<div
    class="min-h-screen bg-gradient-to-br from-indigo-500 via-sky-500 to-purple-600 flex items-center justify-center px-4">
    <div
        class="w-full max-w-4xl bg-white/90 backdrop-blur-lg rounded-2xl shadow-2xl grid md:grid-cols-2 overflow-hidden">
        <!-- Panel trái: logo + slogan -->
        <div
            class="hidden md:flex flex-col justify-between bg-gradient-to-b from-indigo-600 to-purple-700 text-white p-8">
            <div>
                <h2 class="text-2xl font-semibold tracking-wide">Đăng Nhập</h2>
                <p class="mt-2 text-sm text-indigo-100">
                    Hệ thống bán hàng trực tuyến hiện đại, đơn giản và mạnh mẽ.
                </p>
            </div>

            <div>
                <h3 class="text-xl font-semibold mb-3">Chào mừng trở lại 👋</h3>
                <p class="text-sm text-indigo-100 mb-4">
                    Đăng nhập để tiếp tục mua sắm, đặt hàng và theo dõi đơn hàng của bạn.
                </p>
                <ul class="space-y-2 text-sm text-indigo-100">
                    <li class="flex items-center gap-2">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-300"></span>
                        Theo dõi đơn hàng theo thời gian thực
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-300"></span>
                        Mua sắm nhanh chóng và dễ dàng
                    </li>
                    <li class="flex items-center gap-2">
                        <span class="inline-block w-2 h-2 rounded-full bg-emerald-300"></span>
                        Thanh toán nhanh chóng và an toàn
                    </li>
                </ul>
            </div>
        </div>

        <!-- Panel phải: form đăng nhập -->
        <div class="p-8 md:p-10">
            <div class="mb-6 text-center md:text-left">
                <h1 class="text-2xl font-bold text-gray-900">Đăng nhập</h1>
                <p class="mt-1 text-sm text-gray-500">
                    Nhập thông tin tài khoản để tiếp tục.
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
                    @Error
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                        <InputText @bind-Value="model.Username"
                            class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <ValidationMessage For="@(() => model.Username)" class="mt-1 text-xs text-red-600" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
                        <InputText @bind-Value="model.Password" type="password"
                            class="mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
                        <ValidationMessage For="@(() => model.Password)" class="mt-1 text-xs text-red-600" />
                    </div>

                    <div class="flex items-center justify-between text-sm">
                        <label class="inline-flex items-center gap-2 text-gray-600">
                            <input type="checkbox"
                                class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                            <span>Ghi nhớ đăng nhập</span>
                        </label>
                        <a href="#" class="text-indigo-600 hover:text-indigo-500 hover:underline">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit"
                        class="w-full mt-2 inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1">
                        Đăng nhập
                    </button>
                </div>
            </EditForm>

            <p class="mt-6 text-center text-sm text-gray-600">
                Chưa có tài khoản?
                <a href="/register" class="font-medium text-indigo-600 hover:text-indigo-500 hover:underline">
                    Đăng ký ngay
                </a>
            </p>
        </div>
    </div>
</div>

@code {
    private LoginModel model = new();
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var token = await TokenStorage.GetTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        Error = null;
        var res = await AuthApi.LoginAsync(new frontendblazor.Models.LoginRequest(model.Username, model.Password));
        if (res is null || !res.Success || res.Data is null || string.IsNullOrWhiteSpace(res.Data.Token))
        {
            Error = res?.Message ?? "Username hoặc mật khẩu không đúng.";
            return;
        }

        await TokenStorage.SetTokenAsync(res.Data.Token);
        await TokenStorage.SetUserInfoAsync(System.Text.Json.JsonSerializer.Serialize(res.Data));
        AuthState.NotifyUserAuthenticated();

        if(res.Data.Role == "admin")
        {
            Nav.NavigateTo("/admin/dashboard");
        }
        else{
            Nav.NavigateTo("/");
        }
    }

    public sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nhập username")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nhập mật khẩu")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Ít nhất 6 ký tự")]
        [System.ComponentModel.DataAnnotations.DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;
    }
}
