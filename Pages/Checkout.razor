@page "/checkout"
@inject NavigationManager Navigation

<PageTitle>Thanh toán an toàn</PageTitle>

<div class="min-h-screen bg-gray-50 text-gray-900 font-sans py-8 lg:py-12 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            @* --- CỘT TRÁI: THÔNG TIN THANH TOÁN --- *@
            <div class="lg:col-span-7 xl:col-span-8 space-y-8">
                
                <div>
                    <h1 class="text-3xl font-bold tracking-tight text-gray-900">Thanh toán</h1>
                    <p class="text-gray-500 mt-2">Hoàn tất đơn hàng của bạn một cách an toàn.</p>
                </div>

                @* 2. Thông tin liên hệ & Giao hàng (Dữ liệu động) *@
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    @* Email *@
                    <div class="p-5 flex justify-between items-center border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="bg-gray-100 p-2 rounded-full text-gray-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Liên hệ</p>
                                <p class="text-gray-900 font-medium">@customerEmail</p>
                            </div>
                        </div>
                        <button @onclick='() => OpenModal("contact")' class="text-emerald-600 text-sm font-medium hover:underline px-2 py-1 rounded hover:bg-emerald-50 transition">
                            Sửa
                        </button>
                    </div>

                    @* Địa chỉ *@
                    <div class="p-5 flex justify-between items-center">
                        <div class="flex items-center gap-3">
                            <div class="bg-gray-100 p-2 rounded-full text-gray-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-500">Giao tới</p>
                                <p class="text-gray-900 font-medium">@shippingAddress</p>
                            </div>
                        </div>
                        <button @onclick='() => OpenModal("address")' class="text-emerald-600 text-sm font-medium hover:underline px-2 py-1 rounded hover:bg-emerald-50 transition">
                            Sửa
                        </button>
                    </div>
                </div>

                @* 3. Chi tiết thanh toán *@
                <section class="space-y-4">
                    <h2 class="text-xl font-bold text-gray-900">Phương thức thanh toán</h2>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-6">
                        
                        @* Tabs chuyển đổi (Rõ ràng hơn) *@
                        <div class="flex space-x-2 rounded-lg bg-gray-100 p-1">
                            @* Nút Thẻ *@
                            <button @onclick='() => paymentMethod = "card"' 
                                    class="flex-1 rounded-md text-sm font-medium py-3 flex items-center justify-center gap-2 transition-all duration-200 @(paymentMethod == "card" ? "bg-white shadow text-emerald-400 ring-1 ring-black/5" : "text-gray-500 hover:text-gray-700 hover:bg-gray-200")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                </svg>
                                Thẻ quốc tế
                                @if(paymentMethod == "card") { <span class="ml-1 w-2 h-2 bg-emerald-600 rounded-full"></span> }
                            </button>

                            @* Nút COD *@
                            <button @onclick='() => paymentMethod = "cod"' 
                                    class="flex-1 rounded-md text-sm font-medium py-3 flex items-center justify-center gap-2 transition-all duration-200 @(paymentMethod == "cod" ? "bg-white shadow text-emerald-500 ring-1 ring-black/5" : "text-gray-500 hover:text-gray-700 hover:bg-gray-200")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                COD (Tiền mặt)
                                @if(paymentMethod == "cod") { <span class="ml-1 w-2 h-2 bg-emerald-600 rounded-full"></span> }
                            </button>
                        </div>

                        @* Nội dung thay đổi theo Tab *@
                        @if (paymentMethod == "card")
                        {
                            <div class="space-y-4 animate-fade-in">
                                <div class="space-y-1">
                                    <label class="block text-sm font-medium text-gray-700">Số thẻ</label>
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                            </svg>
                                        </div>
                                        <input type="text" class="block w-full pl-10 rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm py-3" placeholder="0000 0000 0000 0000" />
                                    </div>
                                </div>
                                <div class="flex gap-4">
                                    <div class="flex-1 space-y-1">
                                        <label class="block text-sm font-medium text-gray-700">Hết hạn</label>
                                        <input type="text" class="block w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm py-3 pl-2" placeholder="MM / YY" />
                                    </div>
                                    <div class="flex-1 space-y-1">
                                        <label class="block text-sm font-medium text-gray-700">CVC</label>
                                        <input type="text" class="block w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm py-3 pl-2" placeholder="123" />
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-6 text-center animate-fade-in bg-emerald-50 rounded-lg border border-emerald-100">
                                <div class="h-12 w-12 bg-emerald-100 rounded-full flex items-center justify-center mb-3 text-emerald-600">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <h3 class="text-sm font-bold text-gray-900">Thanh toán khi nhận hàng</h3>
                                <p class="text-sm text-gray-500 mt-1 max-w-xs">Bạn sẽ thanh toán bằng tiền mặt cho nhân viên giao hàng khi nhận được kiện hàng.</p>
                            </div>
                        }
                    </div>
                </section>
            </div>

            @* --- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG --- *@
            @* --- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG (STICKY) --- *@
            <div class="lg:col-span-5 xl:col-span-4">
                <div class="sticky top-8 space-y-6">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                        <div class="p-6 bg-gray-50 border-b border-gray-100">
                            <h3 class="font-bold text-gray-900 text-lg">Đơn hàng của bạn</h3>
                        </div>
                        
                        <div class="p-6 space-y-6">
                            @* Danh sách sản phẩm (Có scroll nếu dài) *@
                            <div class="space-y-4 max-h-[250px] overflow-y-auto pr-2 border p-2 rounded-lg custom-scrollbar">
                                @foreach (var item in cartItems)
                                {
                                    <div class="flex gap-4">
                                        <div class="h-16 w-16 shrink-0 overflow-hidden rounded-md border border-gray-200 bg-white p-1">
                                            <img src="@item.ImageUrl" class="h-full w-full object-contain mix-blend-multiply" />
                                        </div>
                                        <div class="flex flex-1 flex-col justify-between">
                                            <div>
                                                <h4 class="text-sm font-medium text-gray-900 line-clamp-1">@item.ProductName</h4>
                                                <p class="text-xs text-gray-500 mt-1">x @item.Quantity</p>
                                            </div>
                                            <p class="text-sm font-semibold text-gray-900">@((item.Price * item.Quantity).ToString("N0")) ₫</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <hr class="border-gray-100" />

                            @* Mã giảm giá *@
                            <div class="flex gap-2">
                                <input type="text" placeholder="Mã giảm giá" class="block w-full rounded-lg border-gray-300 sm:text-sm py-2 focus:ring-blue-500 focus:border-blue-500" />
                                <button class="rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200 transition-colors">Áp dụng</button>
                            </div>

                            <hr class="border-gray-100" />

                            @* Tính toán *@
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between text-gray-500">
                                    <span>Tạm tính</span>
                                    <span class="font-medium text-gray-900">@SubTotal.ToString("N0") ₫</span>
                                </div>
                                <div class="flex justify-between text-gray-500">
                                    <span>Phí vận chuyển</span>
                                    <span class="text-emerald-400 font-medium">Miễn phí</span>
                                </div>
                                <div class="flex justify-between text-gray-500">
                                    <span>Thuế VAT (8%)</span>
                                    <span class="font-medium text-gray-900">@((SubTotal * 0.08m).ToString("N0")) ₫</span>
                                </div>
                            </div>

                            <hr class="border-gray-100" />

                            @* Tổng cộng *@
                            <div class="flex justify-between items-center">
                                <span class="text-base font-bold text-gray-900">Tổng cộng</span>
                                <div class="text-right">
                                    <p class="text-xs text-gray-500 mb-0.5">VND</p>
                                    <p class="text-2xl font-bold text-emerald-400 tracking-tight">@((SubTotal * 1.08m).ToString("N0")) ₫</p>
                                </div>
                            </div>

                            @* Nút thanh toán *@
                            <button @onclick="HandlePayment" class="w-full flex items-center justify-center rounded-xl bg-emerald-600 px-8 py-4 text-base font-bold text-white shadow-lg shadow-blue-500/30 hover:bg-emerald-400 transition-all active:scale-[0.98]">
                                Thanh toán ngay
                            </button>
                        </div>
                    </div>

                    @* Trust Badges *@
                    <div class="flex justify-center gap-6 opacity-60 grayscale hover:grayscale-0 transition-all duration-500">
                        <div class="flex items-center gap-1 text-xs font-semibold text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            <span>Bảo mật SSL</span>
                        </div>
                        <div class="flex items-center gap-1 text-xs font-semibold text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                            </svg>
                            <span>Bảo vệ người mua</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    
@* Style tùy chọn để thanh cuộn đẹp hơn (giống MacOS/Mobile) *@
<style>
    /* Ẩn thanh cuộn mặc định xấu xí */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #e5e7eb; /* gray-200 */
        border-radius: 20px;
    }
    .custom-scrollbar:hover::-webkit-scrollbar-thumb {
        background-color: #d1d5db; /* gray-300 */
    }
</style>
    @* --- MODAL CHỈNH SỬA THÔNG TIN --- *@
    @if (isModalOpen)
    {
        @* Backdrop làm mờ *@
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 transition-opacity" @onclick="CloseModal"></div>

        @* Modal Content *@
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md pointer-events-auto transform transition-all scale-100 p-6 space-y-6">
                
                <div class="flex justify-between items-center">
                    <h3 class="text-xl font-bold text-gray-900">
                        @(modalType == "contact" ? "Sửa thông tin liên hệ" : "Sửa địa chỉ giao hàng")
                    </h3>
                    <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                @if (modalType == "contact")
                {
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" @bind="tempEmail" class="block w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-3 border" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                            <input type="tel" class="block w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-3 border" placeholder="090..." />
                        </div>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ đầy đủ</label>
                            <textarea @bind="tempAddress" rows="3" class="block w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 sm:text-sm p-3 border"></textarea>
                        </div>
                        <div class="flex gap-4">
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Thành phố</label>
                                <input type="text" class="block w-full rounded-lg border-gray-300 border p-2 sm:text-sm" placeholder="TP.HCM" />
                            </div>
                            <div class="flex-1">
                                <label class="block text-sm font-medium text-gray-700 mb-1">Quận/Huyện</label>
                                <input type="text" class="block w-full rounded-lg border-gray-300 border p-2 sm:text-sm" placeholder="Quận 1" />
                            </div>
                        </div>
                    </div>
                }

                <div class="flex gap-3 pt-2">
                    <button @onclick="CloseModal" class="flex-1 px-4 py-3 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition">
                        Hủy
                    </button>
                    <button @onclick="SaveInfo" class="flex-1 px-4 py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-500/30">
                        Lưu thay đổi
                    </button>
                </div>

            </div>
        </div>
    }
</div>

@* Animation nhỏ cho chuyển tab mượt *@
<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    public class CartItem { /* ... Giữ nguyên model ... */ public int ProductId; public string ProductName; public decimal Price; public int Quantity; public string ImageUrl; }
    private List<CartItem> cartItems = new List<CartItem>(); // Giả lập data như cũ
    private decimal SubTotal => cartItems.Sum(x => x.Price * x.Quantity);

    // --- LOGIC THANH TOÁN ---
    private string paymentMethod = "card"; // Mặc định là thẻ

    // --- LOGIC MODAL ---
    private bool isModalOpen = false;
    private string modalType = ""; // "contact" hoặc "address"

    // Dữ liệu chính
    private string customerEmail = "khachhang@example.com";
    private string shippingAddress = "123 Đường Lê Lợi, Quận 1, TP.HCM";

    // Dữ liệu tạm (khi đang sửa trong modal)
    private string tempEmail = "";
    private string tempAddress = "";

    protected override void OnInitialized()
    {
        // Mock Data
        cartItems = new List<CartItem>
        {
            new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" },
    new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" },        new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" },
new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" },        new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" },
new CartItem { ProductId = 1, ProductName = "iPhone 15 Pro Max", Price = 34990000, Quantity = 1, ImageUrl = "https://cdn.tgdd.vn/Products/Images/42/305658/iphone-15-pro-max-titan-tu-nhien-1-1-600x600.jpg" }
      
        };
    }

    private void OpenModal(string type)
    {
        modalType = type;
        // Copy dữ liệu hiện tại vào biến tạm để sửa
        if (type == "contact") tempEmail = customerEmail;
        if (type == "address") tempAddress = shippingAddress;
        
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private void SaveInfo()
    {
        // Lưu dữ liệu tạm vào dữ liệu chính
        if (modalType == "contact") customerEmail = tempEmail;
        if (modalType == "address") shippingAddress = tempAddress;
        
        isModalOpen = false;
    }

    private void HandlePayment()
    {
        Navigation.NavigateTo("/payment-success");
    }
}