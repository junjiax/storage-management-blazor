@page "/admin/inventories"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject AuthApi AuthApi
@inject InventoryApi InventoryApi
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="p-6 space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-3xl font-bold text-gray-800">Quản lý tồn kho</h2>

        <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow transition" @onclick="Add">
            + Thêm tồn kho
        </button>
    </div>

    <!-- Search -->
    <div class="flex items-center gap-3">
        <input type="text" placeholder="Tìm kiếm theo tên sản phẩm..."
               class="w-72 px-4 py-1 border rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
               @bind="searchQuery" @oninput="OnSearchChanged" />
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-white shadow-xl border rounded-xl mt-4">
        <table class="min-w-full">
            <thead class="bg-gray-100 border-b">
                <tr class="text-gray-700 uppercase text-sm">
                    <th class="px-4 py-3 text-left">ID</th>
                    <th class="px-4 py-3 text-left">Mã sản phẩm</th>
                    <th class="px-4 py-3 text-left">Hình ảnh</th>
                    <th class="px-4 py-3 text-left">Tên sản phẩm</th>
                    <th class="px-4 py-3 text-left">Số lượng tồn</th>
                    <th class="px-4 py-3 text-left">Ngày cập nhật</th>
                    <th class="px-4 py-3 text-center w-32">Actions</th>
                </tr>
            </thead>

            <tbody class="text-gray-800 text-sm">
                @if (filteredInventories != null && filteredInventories.Count > 0)
                {
                    @foreach (var item in filteredInventories)
                    {
                        <tr class="border-b hover:bg-blue-50 transition cursor-pointer"
                            @onclick="() => OpenLogModal(item.InventoryId)">
                            <td class="px-4 py-3">@item.InventoryId</td>

                            <td class="px-4 py-3">@item.ProductId</td>

                            <td class="px-4 py-3">
                                <img src="@item.ProductImg" alt="Ảnh sản phẩm" class="w-12 h-12 object-cover rounded-md shadow" />
                            </td>

                            <td class="px-4 py-3 font-medium">@item.ProductName</td>

                            <td class="px-4 py-3 font-semibold text-blue-600">@item.Quantity</td>

                            <td class="px-4 py-3">@item.UpdatedAt</td>

                            <td class="px-4 py-3 text-center flex justify-center gap-2">
                                <button class="px-3 py-1 bg-yellow-400 hover:bg-yellow-500 text-black rounded-lg text-xs shadow"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => Update(item.InventoryId)">
                                    Sửa
                                </button>

                                <button class="px-3 py-1 bg-red-500 hover:bg-red-600 text-black rounded-lg text-xs shadow"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ConfirmDelete(item.InventoryId)">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-6 text-gray-500">
                            Không có dữ liệu tồn kho.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- ========================= -->
<!--      MODAL LỊCH SỬ       -->
<!-- ========================= -->

@if (showLogModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl p-6 w-[550px]">

            <h3 class="text-xl font-bold mb-4">Lịch sử cập nhật tồn kho</h3>

            @if (inventoryLogs == null)
            {
                <p>Đang tải...</p>
            }
            else if (inventoryLogs.Count == 0)
            {
                <p class="text-gray-500">Không có lịch sử cập nhật.</p>
            }
            else
            {
                <ul class="space-y-3 max-h-96 overflow-y-auto">
                    @foreach (var log in inventoryLogs)
                    {
                        <li class="border p-3 rounded-lg bg-gray-100">
                            <p><b>Số lượng thay đổi:</b> @log.ChangeQuantity</p>
                            <p><b>Ghi chú:</b> @log.Note</p>
                            <p><b>Thời gian:</b> @log.UpdatedAt</p>
                        </li>
                    }
                </ul>
            }

            <div class="text-right mt-4">
                <button class="px-4 py-2 bg-red-500 text-white rounded-lg" @onclick="CloseModal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<InventoryResponse> inventories = new();
    private List<InventoryResponse> filteredInventories = new();
    private List<InventoryLogResponse>? inventoryLogs;

    private string searchQuery = string.Empty;

    private bool showLogModal = false;
    private int selectedInventoryId;

    protected override async Task OnInitializedAsync()
    {
        await LoadInventories();
    }

    private async Task LoadInventories()
    {
        var inventoryApiResponse = await InventoryApi.GetAllAsync();

        if (inventoryApiResponse?.Data != null)
        {
            inventories = inventoryApiResponse.Data;
            filteredInventories = inventories;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString()?.Trim().ToLower() ?? "";

        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredInventories = inventories;
            return;
        }

        filteredInventories = inventories
            .Where(inv =>
                inv.InventoryId.ToString().Contains(searchQuery) ||
                inv.ProductId.ToString().Contains(searchQuery) ||
                (!string.IsNullOrEmpty(inv.ProductName) &&
                 inv.ProductName.ToLower().Contains(searchQuery)) ||
                inv.Quantity.ToString().Contains(searchQuery)
            )
            .ToList();
    }

    private void Add() => Nav.NavigateTo("/admin/inventories/add", true);
    private void Update(int id) => Nav.NavigateTo($"/admin/inventories/update/{id}", true);

    private async Task ConfirmDelete(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa tồn kho id = {id}?");
        if (confirmed)
        {
            var response = await InventoryApi.DeleteAsync(id);
            if (response?.Success == true)
            {
                await JS.InvokeVoidAsync("alert", "Xóa thành công!");
                await LoadInventories();
                OnSearchChanged(new ChangeEventArgs { Value = searchQuery });
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Xóa thất bại!");
            }
        }
    }

    private async Task OpenLogModal(int inventoryId)
    {
        selectedInventoryId = inventoryId;
        showLogModal = true;

        inventoryLogs = null;
        StateHasChanged();

        @* var response = await InventoryApi.GetLogsByInventoryIdAsync(inventoryId); *@

        @* inventoryLogs = response?.Data ?? new List<InventoryLogResponse>(); *@

        StateHasChanged();
    }

    private void CloseModal()
    {
        showLogModal = false;
        inventoryLogs = null;
    }
}
