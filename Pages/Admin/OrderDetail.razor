@page "/admin/order/{id:int}"
@using frontendblazor.Models
@using frontendblazor.Services
@inject OrderApi orderApi
@inject NavigationManager Nav

<h2 class="text-2xl font-bold mb-4">Chi tiết đơn hàng #@id</h2>

@if (order == null)
{
    <p>Đang tải dữ liệu...</p>
}
else
{
    <div class="bg-white p-5 shadow-lg rounded-xl mb-4">
        <h3 class="text-xl font-semibold mb-2">Thông tin đơn hàng</h3>
        <p><strong>Khách hàng:</strong> @order.CustomerName</p>
        <p><strong>Nhân viên:</strong> @order.UserName</p>
        <p><strong>Ngày đặt:</strong> @order.OrderDate</p>
        <p><strong>Trạng thái:</strong> @order.Status</p>
        <p><strong>Giảm giá:</strong> @order.DiscountAmount</p>
        <p><strong>Tổng tiền:</strong> @order.TotalAmount</p>
    </div>

    <div class="bg-white p-5 shadow-lg rounded-xl">
        <h3 class="text-xl font-semibold mb-3">Sản phẩm trong đơn</h3>

        <table class="min-w-full border-collapse">
            <thead class="bg-gray-100 border-b">
                <tr>
                    <th class="px-4 py-2 text-left">Tên SP</th>
                    <th class="px-4 py-2 text-left">Số lượng</th>
                    <th class="px-4 py-2 text-left">Giá</th>
                    <th class="px-4 py-2 text-left">Tổng</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var i in order.Items)
                {
                    <tr class="border-b">
                        <td class="px-4 py-2">@i.ProductName</td>
                        <td class="px-4 py-2">@i.Quantity</td>
                        <td class="px-4 py-2">@i.Price</td>
                        <td class="px-4 py-2">@i.Subtotal</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    private OrderResponse? order;

    protected override async Task OnInitializedAsync()
    {
        var response = await orderApi.GetByIdAsync(id);

        if (response != null && response.Data != null)
            order = response.Data;
    }
}
