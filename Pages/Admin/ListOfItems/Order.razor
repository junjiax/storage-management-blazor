@page "/admin/orders"
@using frontendblazor.Models
@using frontendblazor.Services

@inject NavigationManager Nav
@inject OrderApi orderrApi

<h3 class="text-2xl font-semibold mb-3">Quản lý đơn hàng</h3>

<div class="d-flex flex-wrap align-items-center mb-3 gap-3">
    <!-- Search -->
    <input type="text"
           placeholder="Tìm theo khách hàng / người tạo..."
           class="w-72 px-4 py-1 border rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 mr-8"
           @bind="searchTerm" />

    <!-- Filter Status -->
    <select class="px-3 py-1 border rounded-lg"
            @bind="selectedStatus">
        <option value="">-- Tất cả trạng thái --</option>
        <option value="paid">Đã thanh toán</option>
        <option value="pending">Chờ thanh toán</option>
    </select>

    <!-- Sort -->
    <select class="px-3 py-1 border rounded-lg"
            @bind="sortOrder">
        <option value="desc">Ngày mới nhất</option>
        <option value="asc">Ngày cũ nhất</option>
    </select>

    <button class="px-3 py-1 bg-gray-200 border border-gray-300 rounded 
                hover:bg-gray-300 hover:border-gray-400"
            @onclick="SearchOrders">
        Tìm kiếm
    </button>


</div>
<div class="flex items-center gap-4 mb-4 p-3  ">

    <!-- From date -->
    <div class="flex items-center gap-2">
        <label class="text-sm text-gray-600">Từ</label>
        <input type="date"
               class="px-3 py-1 border rounded-lg"
               @bind="fromDate" />
    </div>

    <!-- To date -->
    <div class="flex items-center gap-2">
        <label class="text-sm text-gray-600">Đến</label>
        <input type="date"
               class="px-3 py-1 border rounded-lg"
               @bind="toDate" />
    </div>

    <!-- Clear date filter -->
    <button class="px-3 py-1 bg-gray-200 border border-gray-300 rounded 
               hover:bg-gray-300 hover:border-gray-400"
        @onclick="ClearDateFilter">
        Làm mới
    </button>


</div>


<!-- Bảng danh sách -->
<div class="overflow-x-auto bg-white shadow-lg border rounded-xl mt-4">
    <table class="min-w-full border-collapse">
        <thead class="bg-gray-100 border-b">
            <tr>
                <th class="px-4 py-2 text-left font-medium">Tên khách hàng</th>
                <th class="px-4 py-2 text-left font-medium">Người tạo đơn</th>
                <th class="px-4 py-2 text-left font-medium">Mã giảm giá</th>
                <th class="px-4 py-2 text-left font-medium">Ngày tạo</th>
                <th class="px-4 py-2 text-left font-medium">Trạng thái</th>
                <th class="px-4 py-2 text-left font-medium">Số tiền giảm giá</th>
                <th class="px-4 py-2 text-left font-medium">Tổng tiền</th>
                <th class="px-4 py-2 text-left font-medium">Xem chi tiết</th>
            </tr>
        </thead>
        <tbody>
            @if (orders != null)
            {
                @foreach (var item in PagedOrders)
                {
                    <tr>
                        <td class="px-4 py-2">@item.CustomerName</td>
                        <td class="px-4 py-2">@item.UserName</td>
                        @if (@item.PromoCode != null)
                        {
                            <td class="px-4 py-2">@item.PromoCode</td>
                        }
                        else
                        {
                            <td class="px-4 py-2">none</td>
                        }
                        <td class="px-4 py-2">@item.OrderDate</td>
                        @if (item.Status == "paid")
                        {
                            <td class="px-4 py-2">
                                <span style="
                        background:#d1fae5; 
                        color:#065f46; 
                        padding:4px 10px; 
                        border-radius:8px; 
                        font-weight:bold;
                        font-size:14px;">
                                    Đã thanh toán
                                </span>
                            </td>
                        }
                        else
                        {
                            <td class="px-4 py-2">
                                <span style="
                        background:#fef3c7; 
                        color:#92400e; 
                        padding:4px 10px; 
                        border-radius:8px; 
                        font-weight:bold;
                        font-size:14px;">
                                    Chờ thanh toán
                                </span>
                            </td>
                        }




                        <td class="px-4 py-2">@item.DiscountAmount</td>
                        <td class="px-4 py-2">@item.TotalAmount</td>
                        <td class="px-4 py-2">
                            <button class="btn btn-sm btn-info d-flex align-items-center gap-1"
        @onclick="() => ViewOrder(item.OrderId)">
    <i class="bi bi-receipt"></i>
    Xem hóa đơn
</button>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="flex justify-center items-center gap-3 mt-4">
    <button class="px-3 py-1 bg-gray-200 rounded disabled:opacity-50" @onclick="PrevPage"
        disabled="@(currentPage == 1)">
        <i class="bi bi-chevron-left"></i>
    </button>

    <span>Trang @currentPage / @totalPages</span>

    <button class="px-3 py-1 bg-gray-200 rounded disabled:opacity-50" @onclick="NextPage"
        disabled="@(currentPage == totalPages)">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@code {
    private int? customerId;
    private List<OrderResponse> orders = new List<OrderResponse>();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)orders.Count / pageSize);

    private string searchTerm = "";
    private string selectedStatus = "";
    private DateTime? fromDate;
    private DateTime? toDate;
    private string sortOrder = "desc";


    private IEnumerable<OrderResponse> PagedOrders =>
    orders.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        customerId = GetQueryInt("customerId");

        if (customerId.HasValue)
            await LoadOrdersByCustomer(customerId.Value);
        else
            await LoadAllOrders();
    }

    private int? GetQueryInt(string key)
    {
        var uri = new Uri(Nav.Uri);
        var query = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);

        foreach (var item in query)
        {
            var kv = item.Split('=');
            if (kv.Length == 2 && kv[0] == key && int.TryParse(kv[1], out var value))
                return value;
        }
        return null;
    }

    private async Task LoadOrdersByCustomer(int customerId)
    {
        var res = await orderrApi.GetByCustomerIdAsync(customerId);
        if (res?.Success == true)
            orders = res.Data!;
    }

    private async Task LoadAllOrders()
    {
        var res = await orderrApi.GetAllAsync();
        if (res?.Success == true)
            orders = res.Data!;
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    void ViewOrder(int id)
    {
        Nav.NavigateTo($"/admin/order/{id}");
    }

    private async Task SearchOrders()
    {
        currentPage = 1;

        var res = await orderrApi.SearchAsync(
            keyword: searchTerm,
            status: selectedStatus,
            fromDate: fromDate,
            toDate: toDate,
            sortOrder: sortOrder
        );

        if (res?.Success == true && res.Data != null)
        {
            orders = res.Data;
        }
    }

    private async Task ClearDateFilter()
    {
        searchTerm = "";
        selectedStatus = "";
        fromDate = null;
        toDate = null;
        sortOrder = "desc";
        currentPage = 1;

        await LoadAllOrders();
    }



}