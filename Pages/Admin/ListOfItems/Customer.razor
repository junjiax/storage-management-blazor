@page "/admin/customers"
@using frontendblazor.Models
@using frontendblazor.Services

@inject NavigationManager Nav
@inject CustomerApi customerApi

<h3 class="text-2xl font-semibold mb-3">Quản lý khách hàng</h3>

<div class="flex items-center gap-3">
    <!-- Search -->
    <input type="text"
       placeholder="Tìm kiếm khách hàng..."
       class="w-72 px-4 py-1 border rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"
       @oninput="async e =>
       {
           searchKeyword = e.Value?.ToString() ?? string.Empty;
           await OnSearchChanged();
       }" />

</div>


<!-- Bảng danh sách -->
<div class="overflow-x-auto bg-white shadow-lg border rounded-xl mt-4">
    <table class="min-w-full border-collapse">
        <thead class="bg-gray-100 border-b">
            <tr>
                <th class="px-4 py-2 text-left font-medium">Tên</th>
                <th class="px-4 py-2 text-left font-medium">Số điện thoại</th>
                <th class="px-4 py-2 text-left font-medium">Email</th>
                <th class="px-4 py-2 text-left font-medium">Địa chỉ</th>
                <th class="px-4 py-2 text-left font-medium">Ngày tạo</th>
                <th class="px-4 py-2 text-left font-medium">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (customers != null)
            {
                @foreach (var item in PagedCustomers)
                {
                    <tr>
                        <td class="px-4 py-2">@item.Name</td>
                        <td class="px-4 py-2">@item.Phone</td>
                        <td class="px-4 py-2">@item.Email</td>
                        <td class="px-4 py-2">@item.Address</td>
                        <td class="px-4 py-2">@item.CreatedAt</td>
                        <td class="px-4 py-2">
                            <button
                                class="bg-blue-500 text-white px-3 py-1 rounded-lg hover:bg-blue-600 flex items-center gap-1"
                                @onclick="() => ViewOrders(item.CustomerId)">
                                <i class="bi bi-receipt" style="font-size:30px; color:green"></i>
                                Xem hóa đơn
                            </button>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="flex justify-center items-center gap-3 mt-4">
    <button class="px-3 py-1 bg-gray-200 rounded disabled:opacity-50" @onclick="PrevPage"
        disabled="@(currentPage == 1)">
        <i class="bi bi-chevron-left"></i>
    </button>

    <span>Trang @currentPage / @totalPages</span>

    <button class="px-3 py-1 bg-gray-200 rounded disabled:opacity-50" @onclick="NextPage"
        disabled="@(currentPage == totalPages)">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@code {
    private List<CustomerResponse> customers = new List<CustomerResponse>();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)customers.Count / pageSize);
    private IEnumerable<CustomerResponse> PagedCustomers =>
    customers.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private string searchKeyword = string.Empty;
    private CancellationTokenSource? searchCts;


    void GoToAddPage()
    {
        Nav.NavigateTo("/admin/customers/add");
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        var getCustomersResponse = await customerApi.GetAllAsync();

        if (getCustomersResponse != null && getCustomersResponse.Data != null)
        {
            customers = getCustomersResponse.Data;
        }
    }

    void NextPage()
    {
        if (currentPage < totalPages)
            currentPage++;
    }

    void PrevPage()
    {
        if (currentPage > 1)
            currentPage--;
    }

    void ViewOrders(int customerId)
    {
        Nav.NavigateTo($"/admin/orders?customerId={customerId}");
    }

    private async Task OnSearchChanged()
    {
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, searchCts.Token); // debounce 300ms

            if (string.IsNullOrWhiteSpace(searchKeyword))
            {
                await LoadCustomers();
            }
            else
            {
                var res = await customerApi.SearchByNameAsync(searchKeyword, searchCts.Token);
                if (res?.Data != null)
                {
                    customers = res.Data;
                    currentPage = 1; // reset phân trang
                }
            }
        }
        catch (TaskCanceledException) { }
    }


}