@page "/admin/users/add"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject UserApi UserApi

@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Thêm tài khoản mới</h2>

    <EditForm Model="NewUser" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@

        <div>
            <label>Tên người dùng</label>
            <InputText @bind-Value="NewUser.FullName" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewUser.FullName)" class="text-red-600 text-sm mt-1" />

        </div>

        <div>
            <label>Tên đăng nhập</label>
            <InputText @bind-Value="NewUser.Username" class="w-full border rounded px-2 py-1" />
            <ValidationMessage  class="text-red-600 text-sm mt-1" For="@(() => NewUser.Username)" />
        </div>

        <div>
            <label>Mật khẩu</label>
            <InputText type="password"
                    @bind-Value="NewUser.Password"
                    class="w-full border rounded px-2 py-1" />

            <ValidationMessage For="@(() => NewUser.Password)"
                            class="text-red-600 text-sm mt-1" />
        </div>

       <div>
        <label>Vai trò</label>
        <InputSelect @bind-Value="NewUser.Role"
                    class="w-full border rounded px-2 py-1">
            <option value="customer">Customer</option>
            <option value="staff">Staff</option>
            <option value="admin">Admin</option>
        </InputSelect>
        <ValidationMessage For="@(() => NewUser.Role)"
                        class="text-red-600 text-sm mt-1" />
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Thêm tài khoản</button>
            <button type="button" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-500" @onclick="Cancel">Hủy</button>
        </div>
    </EditForm>

</div>

@code {
    private CreateUserRequest NewUser = new CreateUserRequest
    {
        FullName = "",
        Username = "",
        Password = "",
        Role = "customer"
    };

    private void Cancel()
    {
        // reset form hoặc quay về danh sách
        Nav.NavigateTo("/admin/users", true);
    }

    private async Task HandleValidSubmit()
    {
        var response = await UserApi.AddAsync(NewUser);
        if (response != null && response.Success)
        {
            await JS.InvokeVoidAsync("alert", "Thêm tài khoản thành công!");
            // Thêm xong quay về danh sách
            Nav.NavigateTo("/admin/users", true);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Thêm tài khoản thất bại!");
        }
    }
}
