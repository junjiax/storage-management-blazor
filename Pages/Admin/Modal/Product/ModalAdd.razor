@page "/admin/products/add"

@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ProductApi ProductApi
@inject CategoryApi CategoryApi
@inject SupplierApi SupplierApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Thêm sản phẩm mới</h2>

    <EditForm Model="NewProduct" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Danh mục -->
        <div class="mb-3">
            <label>Danh mục</label>
            <select class="w-full border rounded px-2 py-1"
                    @bind="NewProduct.CategoryId">
                <option value="">-- Chọn danh mục --</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">
                        @category.CategoryName
                    </option>
                }
            </select>
        </div>

        <!-- Nhà cung cấp -->
        <div class="mb-3">
            <label>Nhà cung cấp</label>
            <select class="w-full border rounded px-2 py-1"
                    @bind="NewProduct.SupplierId">
                <option value="">-- Chọn nhà cung cấp --</option>
                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.SupplierId">
                        @supplier.Name
                    </option>
                }
            </select>
        </div>

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label>Tên sản phẩm</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="NewProduct.ProductName" />
            <ValidationMessage For="@(() => NewProduct.ProductName)" />
        </div>

        <!-- Barcode -->
        <div class="mb-3">
            <label>Barcode</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="NewProduct.Barcode" />
        </div>

        <!-- Giá -->
        <div class="mb-3">
            <label>Giá</label>
            <InputNumber class="w-full border rounded px-2 py-1"
                         @bind-Value="NewProduct.Price" />
            <ValidationMessage For="@(() => NewProduct.Price)" />
        </div>

        <!-- Đơn vị -->
        <div class="mb-3">
            <label>Đơn vị tính</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="NewProduct.Unit" />
        </div>

        <!-- Upload ảnh -->
        <div class="mb-3">
            <label class="font-medium">Hình ảnh</label>
            <InputFile OnChange="HandleFileUpload"
                       accept="image/*"
                       class="w-full border rounded px-2 py-1" />

            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="mt-2 text-red-600">
                    @uploadError
                </div>
            }
        </div>

        <!-- Buttons -->
        <div class="flex justify-end gap-3 mt-4">
            <button type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Thêm
            </button>

            <button type="button"
                    class="bg-red-500 text-white px-4 py-2 rounded"
                    @onclick="Cancel">
                Hủy
            </button>
        </div>
    </EditForm>
</div>

@code {
    private List<CategoryResponse> categories = new();
    private List<SupplierResponse> suppliers = new();

    private string uploadError = string.Empty;

    private ProductWithUploadImgRequest NewProduct = new()
    {
        Unit = "pcs"
    };

    protected override async Task OnInitializedAsync()
    {
        var categoryRes = await CategoryApi.GetAllAsync();
        var supplierRes = await SupplierApi.GetAllAsync();

        categories = categoryRes?.Data ?? new();
        suppliers = supplierRes?.Data ?? new();
    }

    private async Task HandleValidSubmit()
    {
        var response = await ProductApi.AddAsync(NewProduct);

        if (response?.Success == true)
        {
            await JS.InvokeVoidAsync("alert", "Thêm sản phẩm thành công!");
            Nav.NavigateTo("/admin/products", true);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Thêm sản phẩm thất bại!");
        }
    }

    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        if (!file.ContentType.StartsWith("image/"))
        {
            uploadError = "Chỉ được chọn file ảnh";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            uploadError = "Ảnh không được vượt quá 5MB";
            return;
        }

        uploadError = string.Empty;
        NewProduct.ImageFile = file;
    }

    private void Cancel()
    {
        Nav.NavigateTo("/admin/products");
    }
}
