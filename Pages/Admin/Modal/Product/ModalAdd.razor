@page "/admin/products/add"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject ProductApi ProductApi
@inject CategoryApi CategoryApi
@inject SupplierApi SupplierApi
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Thêm sản phẩm mới</h2>

    <EditForm Model="NewProduct" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div>
            <label>Danh mục</label>
            <select @bind="NewProduct.CategoryId" class="w-full border rounded px-2 py-1">
                <option value="0" disabled selected>-- Chọn danh mục --</option>

                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </select>
        </div>

        <div>
            <label>Nhà cung cấp</label>
            <select @bind="NewProduct.SupplierId" class="w-full border rounded px-2 py-1">
                <option value="0" disabled selected>-- Chọn nhà cung cấp --</option>

                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.SupplierId">@supplier.Name</option>
                }
            </select>
        </div>

        <div>
            <label>Tên sản phẩm</label>
            <InputText @bind-Value="NewProduct.ProductName" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewProduct.ProductName)" />
        </div>

        <div>
            <label>Barcode</label>
            <InputText @bind-Value="NewProduct.Barcode" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewProduct.Barcode)" />
        </div>

        <div>
            <label>Giá</label>
            <InputNumber @bind-Value="NewProduct.Price" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewProduct.Price)" />
        </div>

        <div>
            <label>Đơn vị tính</label>
            <InputText @bind-Value="NewProduct.Unit" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewProduct.Unit)" />
        </div>

        <div>
            <label class="font-medium">Hình ảnh</label>
            <InputFile OnChange="HandleFileUpload" accept="image/*" class="w-full border rounded px-2 py-1" />

            @if (!string.IsNullOrEmpty(NewProduct.ProductImg))
            {
                <div class="mt-3 flex justify-center">
                    <img src="data:image/jpeg;base64,@NewProduct.ProductImg"
                        class="w-40 h-40 object-cover rounded-lg shadow border" />
                </div>
            }


            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="mt-2 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
                    @uploadError
                </div>
            }
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Thêm</button>
            <button type="button" class="bg-red-500 text-white px-4 py-2 rounded" @onclick="Cancel">Hủy</button>
        </div>
    </EditForm>
</div>

@code {
    private List<CategoryResponse> categories = new();
    private List<SupplierResponse> suppliers = new();
    private string uploadError = string.Empty;

    private ProductRequest NewProduct = new()
    {
        CategoryId = 0,
        SupplierId = 0,
        ProductName = "",
        Barcode = "",
        Price = 0,
        Unit = "",
        ProductImg = ""
    };


    protected override async Task OnInitializedAsync()
    {
        var categoryRes = await CategoryApi.GetAllAsync();
        var supplierRes = await SupplierApi.GetAllAsync();

        categories = categoryRes?.Data ?? new();
        suppliers = supplierRes?.Data ?? new();
    }

    private async Task HandleValidSubmit()
    {
        Console.WriteLine("Submitting form with product:");
        Console.WriteLine(NewProduct);
        var response = await ProductApi.AddAsync(NewProduct);
        if (response?.Success == true)
        {
            await JS.InvokeVoidAsync("alert", "Thêm sản phẩm thành công!");
            Cancel();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Thêm sản phẩm thất bại!");
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            uploadError = string.Empty;

            var file = e.File;
            long maxSize = 5 * 1024 * 1024;

            if (file.Size > maxSize)
            {
                uploadError = "Ảnh quá lớn, tối đa 5MB.";
                return;
            }

            using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var base64 = Convert.ToBase64String(ms.ToArray());

            NewProduct = NewProduct with
            {
                ProductImg = base64
            };
        }
        catch (Exception ex)
        {
            uploadError = "Lỗi: " + ex.Message;
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/admin/products", true);
    }
}