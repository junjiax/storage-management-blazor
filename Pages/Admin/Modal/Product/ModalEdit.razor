@page "/admin/products/update/{Id:int}"

@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime JS
@inject ProductApi ProductApi
@inject CategoryApi CategoryApi
@inject SupplierApi SupplierApi
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Sửa sản phẩm</h2>

    <EditForm Model="EditProduct" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Danh mục -->
        <div class="mb-3">
            <label>Danh mục</label>
            <select class="w-full border rounded px-2 py-1"
                    @bind="EditProduct.CategoryId">
                <option value="">-- Chọn danh mục --</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryId">@c.CategoryName</option>
                }
            </select>
        </div>

        <!-- Nhà cung cấp -->
        <div class="mb-3">
            <label>Nhà cung cấp</label>
            <select class="w-full border rounded px-2 py-1"
                    @bind="EditProduct.SupplierId">
                <option value="">-- Chọn nhà cung cấp --</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.SupplierId">@s.Name</option>
                }
            </select>
        </div>

        <!-- Tên sản phẩm -->
        <div class="mb-3">
            <label>Tên sản phẩm</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="EditProduct.ProductName" />
        </div>

        <!-- Barcode -->
        <div class="mb-3">
            <label>Barcode</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="EditProduct.Barcode" />
        </div>

        <!-- Giá -->
        <div class="mb-3">
            <label>Giá</label>
            <InputNumber class="w-full border rounded px-2 py-1"
                         @bind-Value="EditProduct.Price" />
        </div>

        <!-- Đơn vị -->
        <div class="mb-3">
            <label>Đơn vị tính</label>
            <InputText class="w-full border rounded px-2 py-1"
                       @bind-Value="EditProduct.Unit" />
        </div>

        <!-- Ảnh -->
        <div class="mb-3">
            <label class="font-medium">Hình ảnh</label>

            <InputFile OnChange="HandleFileUpload"
                       accept="image/*"
                       class="w-full border rounded px-2 py-1" />

            @if (!string.IsNullOrEmpty(CurrentImageUrl))
            {
                <div class="mt-3 flex justify-center">
                    <img src="@CurrentImageUrl"
                         class="w-40 h-40 object-cover rounded-lg shadow border" />
                </div>
            }

            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="mt-2 text-red-600">
                    @uploadError
                </div>
            }
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <button type="submit"
                    class="bg-blue-600 text-white px-4 py-2 rounded">
                Sửa
            </button>

            <button type="button"
                    class="bg-red-500 text-white px-4 py-2 rounded"
                    @onclick="Cancel">
                Hủy
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ProductWithUploadImgRequest EditProduct = new()
    {
        Unit = "pcs"
    };

    private List<CategoryResponse> categories = new();
    private List<SupplierResponse> suppliers = new();

    private string? CurrentImageUrl;
    private string uploadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSelects();

        var res = await ProductApi.GetByIdAsync(Id);
        if (res?.Data != null)
        {
            EditProduct = new ProductWithUploadImgRequest
            {
                CategoryId = res.Data.CategoryId,
                SupplierId = res.Data.SupplierId,
                ProductName = res.Data.ProductName,
                Barcode = res.Data.Barcode,
                Price = res.Data.Price,
                Unit = res.Data.Unit
            };

            // Ảnh hiện tại từ server (URL)
            CurrentImageUrl = res.Data.ProductImg;
        }
    }

    private async Task LoadSelects()
    {
        categories = (await CategoryApi.GetAllAsync())?.Data ?? new();
        suppliers  = (await SupplierApi.GetAllAsync())?.Data ?? new();
    }

    private void HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (!file.ContentType.StartsWith("image/"))
        {
            uploadError = "Chỉ chấp nhận file ảnh";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            uploadError = "Ảnh không được vượt quá 5MB";
            return;
        }

        uploadError = string.Empty;
        EditProduct.ImageFile = file;
    }

    private async Task HandleValidSubmit()
    {
        var res = await ProductApi.UpdateAsync(EditProduct, Id);

        if (res?.Success == true)
        {
            await JS.InvokeVoidAsync("alert", "Sửa sản phẩm thành công!");
            Nav.NavigateTo("/admin/products", true);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Sửa sản phẩm thất bại!");
        }
    }

    private void Cancel()
    {
        Nav.NavigateTo("/admin/products");
    }
}
