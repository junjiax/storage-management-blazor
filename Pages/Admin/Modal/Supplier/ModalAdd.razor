@page "/admin/suppliers/add"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject SupplierApi SupplierApi

@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Thêm nhà cung cấp mới</h2>

    <EditForm Model="NewSupplier" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@

        <div>
            <label>Tên nhà cung cấp</label>
            <InputText @bind-Value="NewSupplier.Name" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewSupplier.Name)" class="text-red-600 text-sm mt-1" />

        </div>

        <div>
            <label>Số điện thoại</label>
            <InputText @bind-Value="NewSupplier.Phone" class="w-full border rounded px-2 py-1" />
            <ValidationMessage  class="text-red-600 text-sm mt-1" For="@(() => NewSupplier.Phone)" />
        </div>

        <div>
            <label>Email</label>
            <InputText @bind-Value="NewSupplier.Email" class="w-full border rounded px-2 py-1" />
            <ValidationMessage  class="text-red-600 text-sm mt-1" For="@(() => NewSupplier.Email)" />
        </div>

        <div>
            <label>Địa chỉ</label>
            <InputText @bind-Value="NewSupplier.Address" class="w-full border rounded px-2 py-1" />
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Thêm nhà cung cấp</button>
            <button type="button" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-500" @onclick="Cancel">Hủy</button>
        </div>
    </EditForm>

</div>

@code {
    private SupplierRequest NewSupplier = new SupplierRequest
    {
        Name = "",
        Phone = "",
        Email = "",
        Address = ""
    };

    private void Cancel()
    {
        // reset form hoặc quay về danh sách
        Nav.NavigateTo("/admin/suppliers", true);
    }

    private async Task HandleValidSubmit()
    {
        var response = await SupplierApi.AddAsync(NewSupplier);
        if (response != null && response.Success)
        {
            await JS.InvokeVoidAsync("alert", "Thêm nhà cung cấp thành công!");
            // Thêm xong quay về danh sách
            Nav.NavigateTo("/admin/suppliers", true);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Thêm nhà cung cấp thất bại!");
        }
    }
}
