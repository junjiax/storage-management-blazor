@page "/admin/inventories/add"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject ProductApi ProductApi
@inject InventoryApi InventoryApi

@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="max-w-xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold mb-6">Thêm khách hàng mới</h2>

    <EditForm Model="NewInventory" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@

        <div>
            <label>Mã sản phẩm</label>
            <select @bind="NewInventory.ProductId" class="w-full border rounded px-2 py-1">
                <option value="0" disabled selected>-- Chọn sản phẩm --</option>

                @foreach (var product in products)
                {
                    <option value="@product.ProductId">@product.ProductName</option>
                }
            </select>
        </div>
        <div>
            <label>Số lượng</label>
            <InputNumber @bind-Value="NewInventory.Quantity" class="w-full border rounded px-2 py-1" />
            <ValidationMessage For="@(() => NewInventory.Quantity)" />
        </div>

        <div class="flex justify-end gap-3 mt-4">
            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Thêm kho
                hàng</button>
            <button type="button" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-500"
                @onclick="Cancel">Hủy</button>
        </div>
    </EditForm>

</div>

@code {
    private InventoryRequest NewInventory = new InventoryRequest
    {
        ProductId = 0,
        Quantity = 0
    };

    private List<ProductResponse> products = new();

    protected override async Task OnInitializedAsync()
    {
        var productRes = await ProductApi.GetAllAsync();

        products = productRes?.Data ?? new();
    }

    private void Cancel()
    {
        // reset form hoặc quay về danh sách
        Nav.NavigateTo("/admin/inventories", true);
    }

    private async Task HandleValidSubmit()
    {
        var response = await InventoryApi.AddAsync(NewInventory);
        if (response != null && response.Success)
        {
            await JS.InvokeVoidAsync("alert", "Thêm kho hàng thành công!");
            // Thêm xong quay về danh sách
            Cancel();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Thêm kho hàng thất bại!");
        }
    }
}