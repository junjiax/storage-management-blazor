@page "/admin/suppliers"
@using frontendblazor.Models
@using frontendblazor.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject AuthApi AuthApi
@inject SupplierApi SupplierApi
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="p-6 space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between">
        <h2 class="text-3xl font-bold text-gray-800">Quản lý nhà cung cấp</h2>

        <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow transition" @onclick="() => Add()">
            + Thêm nhà cung cấp
        </button>
    </div>

    <!-- Search -->
    <div class="flex items-center gap-3">
        <input type="text" placeholder="Tìm kiếm nhà cung cấp..."
               @bind="searchTerm"
               class="w-72 px-4 py-1 border rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" />

        <button @onclick="SearchSupplier"
                class="px-4 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg shadow border">
            Tìm kiếm
        </button>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto bg-white shadow-xl border rounded-xl mt-4">
        <table class="min-w-full">
            <thead class="bg-gray-100 border-b">
                <tr class="text-gray-700 uppercase text-sm">
                    <th class="px-4 py-3 text-left">ID</th>
                    <th class="px-4 py-3 text-left">Tên khách</th>
                    <th class="px-4 py-3 text-left">Số điện thoại</th>
                    <th class="px-4 py-3 text-left">Email</th>
                    <th class="px-4 py-3 text-left">Địa chỉ</th>
                    <th class="px-4 py-3 text-center w-32">Actions</th>
                </tr>
            </thead>

            <tbody class="text-gray-800 text-sm">
                @if (Pagedsuppliers != null && Pagedsuppliers.Count > 0)
                {
                    @foreach (var item in Pagedsuppliers)
                    {
                        <tr class="border-b hover:bg-blue-50 transition">
                            <td class="px-4 py-3">@item.SupplierId</td>
                            <td class="px-4 py-3 font-medium">@item.Name</td>
                            <td class="px-4 py-3 font-medium">@item.Phone</td>
                            <td class="px-4 py-3 font-medium">@item.Email</td>
                            <td class="px-4 py-3 font-medium">@item.Address</td>
                            <td class="px-4 py-3 text-center flex justify-center gap-2">
                                <button class="px-3 py-1 bg-yellow-400 hover:bg-yellow-500 text-black rounded-lg text-xs shadow" @onclick="() => Update(item.SupplierId)">
                                    Sửa
                                </button>
                                <button class="px-3 py-1 bg-red-500 hover:bg-red-600 text-black rounded-lg text-xs shadow"
                                        @onclick="() => ConfirmDelete(item.SupplierId)">
                                    Xóa
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-6 text-gray-500">
                            Không có nhà cung cấp nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <div class="flex justify-center gap-2 mt-4">
        <button @onclick="PrevPage" class="px-2 py-1 bg-gray-200 rounded" disabled="@(currentPage == 1)">
            &lt; Trước
        </button>

        @for(int i = 1; i <= totalPages; i++)
        {
            int j = i;
            <button @onclick="(() => GoToPage(j))" 
                class="px-3 py-1 rounded-md border 
                                @(currentPage == i 
                                    ? "bg-blue-500 text-blue-600 border-blue-900 shadow" 
                                    : "bg-gray-200 text-gray-700 hover:bg-gray-300")">               
                                     @i
            </button>
        }

        <button @onclick="NextPage" class="px-2 py-1 bg-gray-200 rounded" disabled="@(currentPage == totalPages)">
            Tiếp &gt;
        </button>
    </div>
</div>

@code {
    private List<SupplierResponse> suppliers = new List<SupplierResponse>();
    private List<SupplierResponse> suppliersFilter = new List<SupplierResponse>();

    private string searchTerm = string.Empty;

    // Phân trang
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)suppliersFilter.Count / pageSize);
    


    private List<SupplierResponse> Pagedsuppliers => 
        suppliersFilter.Skip((currentPage - 1) * pageSize)
                         .Take(pageSize)
                         .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadSupplier();
    }

    private async Task LoadSupplier()
    {
        ApiResponse<List<SupplierResponse>>? response = await SupplierApi.GetAllAsync();
        if(response?.Data != null)
        {
            suppliers = response.Data;
            suppliersFilter = response.Data;
        }
    }

    private void SearchSupplier()
    {
       if(suppliers == null) return;

        suppliersFilter = string.IsNullOrWhiteSpace(searchTerm) 
        ? new List<SupplierResponse>(suppliers)
        : suppliers
            .Where(c => (c.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                        (c.Email ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                        (c.Phone ?? "").Contains(searchTerm))
            .ToList();


        currentPage = 1; // reset về trang 1 khi tìm kiếm
    }

    private void GoToPage(int page)
    {
        Console.WriteLine(page);
        currentPage = page;
    }

    private void NextPage()
    {
        if(currentPage < totalPages) currentPage++;
    }

    private void PrevPage()
    {
        if(currentPage > 1) currentPage--;
    }

    private void Add()
    {
        // reset form hoặc quay về danh sách
        Nav.NavigateTo("/admin/suppliers/add", true);
    }
    private void Update(int id)
    {
        // reset form hoặc quay về danh sách
        Nav.NavigateTo($"/admin/suppliers/update/{id}", true);
    }

     private async Task ConfirmDelete(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn xóa nhà cung cấp id = {id}?");
        if (confirmed)
        {
            var response = await SupplierApi.DeleteAsync(id);
            if (response != null && response.Success)
            {
                await JS.InvokeVoidAsync("alert", "Xóa thành công!");
                await LoadSupplier(); // load lại danh sách
                SearchSupplier();
            }
            else{
                await JS.InvokeVoidAsync("alert", "Xóa thất bại!");
            }
        }
    }
}