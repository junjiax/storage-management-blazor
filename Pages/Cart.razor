@page "/cart"

@using frontendblazor.Services
@using frontendblazor.Models
@inject NavigationManager Navigation
@inject CartService CartService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Giỏ hàng của bạn</PageTitle>

@* Container chính với nền xám nhẹ *@
<div class="min-h-screen bg-gray-50 text-gray-900 font-sans transition-colors duration-200 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        @* Header *@
        <div class="my-8">
            <h1 class="text-3xl font-bold tracking-tight">Giỏ hàng <span class="text-sm text-gray-500">(@cartItems.Count sản phẩm)</span></h1>
            <button @onclick="() => SetFakeCart()">Set Fake Cart</button>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            
            @* --- CỘT TRÁI: DANH SÁCH SẢN PHẨM --- *@
            <div class="lg:w-2/3 space-y-6">
                @if (cartItems.Count == 0)
                {
                    <div class="bg-white rounded-xl p-12 text-center shadow-sm border border-gray-200">
                        <div class="flex justify-center mb-4 text-gray-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900">Giỏ hàng của bạn đang trống</h3>
                        <p class="text-gray-500 mt-1 mb-6">Hãy thêm sản phẩm để tiến hành thanh toán.</p>
                        <button @onclick='() => Navigation.NavigateTo("/")' class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
                            Quay lại cửa hàng
                        </button>
                    </div>
                }
                else
                {
                    @* --- BẮT ĐẦU VÙNG CUỘN (SCROLL AREA) --- *@
                    @* h-[600px]: Giới hạn chiều cao khoảng 600px *@
                    @* overflow-y-auto: Tự động hiện thanh cuộn khi nội dung dài *@
                    @* pr-2: Thêm đệm bên phải để thanh cuộn không che nội dung *@

                    <div class="h-[600px] overflow-y-auto bg-white space-y-6 custom-scrollbar shadow-lg rounded-lg p-6">
                        @foreach (var item in cartItems)
                        {
                            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 transition-all hover:shadow-md">
                                <div class="flex flex-col sm:flex-row items-center gap-6">
                                
                                    @* Ảnh sản phẩm *@
                                    <div class="w-24 h-24 sm:w-32 sm:h-32 flex-shrink-0 bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center p-2">
                                        <img src="@item.ProductImg" alt="@item.ProductName" class="w-full h-full object-contain mix-blend-multiply" />
                                    </div>

                                    @* Thông tin chi tiết *@
                                    <div class="flex-1 w-full text-center sm:text-left">
                                        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2">
                                            <div>
                                                <h3 class="text-lg font-semibold text-gray-900">@item.ProductName</h3>
                                                
                                                <p class="text-md font-semibold text-gray-500">@((item.Price).ToString("N0")) đ</p>
                                            </div>
                                        
                                            @* Giá tiền *@
                                            <div class="mt-2 sm:mt-0 text-right">
                                                <span class="text-lg font-bold text-emerald-600 block">
                                                    @((item.Price * item.Quantity).ToString("N0")) ₫
                                                </span
                                            </div>
                                        </div>

                                        @* Các nút thao tác *@
                                        <div class="flex items-center justify-center sm:justify-between mt-4 pt-4 border-t border-gray-100">
                                        
                                            @* Nút xóa *@
                                            <button @onclick="() => RemoveItem(item)" class="flex items-center gap-2 text-sm text-gray-500 hover:text-red-500 transition-colors cursor-pointer group">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                                <span>Xóa</span>
                                            </button>

                                            @* Bộ tăng giảm số lượng *@
                                            <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden">
                                                <button @onclick="() => DecreaseQty(item)" class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 transition-colors text-gray-600">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                                    </svg>
                                                </button>
                                                <input type="text" readonly value="@item.Quantity" class="w-10 h-8 text-center border-none bg-transparent text-sm focus:ring-0 p-0 text-gray-900 font-medium" />
                                                <button @onclick="() => IncreaseQty(item)" class="w-8 h-8 flex items-center justify-center hover:bg-gray-100 transition-colors text-gray-600">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                          }
                     </div>
                     @* --- KẾT THÚC VÙNG CUỘN --- *@
                }
            </div>

            @* --- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG --- *@
            <div class="lg:w-1/3">
                <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-200 sticky top-8">
                    <h2 class="text-xl font-bold mb-6 text-gray-900">Tóm tắt đơn hàng</h2>
                    
                    <div class="space-y-4 text-sm">
                        <div class="flex justify-between items-center text-gray-600">
                            <span>Tạm tính</span>
                            <span class="font-medium text-gray-900">@SubTotal.ToString("N0") ₫</span>
                        </div>
                        <div class="flex justify-between items-center text-gray-600">
                            <span>Giảm giá</span>
                            <span class="font-medium text-green-600">- @Discount.ToString("N0") ₫</span>
                        </div>
                        <div class="flex justify-between items-center text-gray-600">
                            <span>Phí vận chuyển</span>
                            <span class="font-medium text-green-600">Miễn phí</span>
                        </div>

                        @* Form Mã giảm giá *@
                        <div class="pt-4 pb-2">
                            <label for="promo" class="block text-xs font-medium text-gray-700 mb-2 uppercase tracking-wide">Mã giảm giá</label>
                            <div class="flex gap-2">
                                <input type="text" id="promo" placeholder="Nhập mã giảm giá" class="flex-1 rounded-lg border-gray-300 bg-gray-50 text-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 p-2.5 outline-none border" />
                                <button class="bg-gray-200 text-gray-800 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-300 transition-colors">
                                    Áp dụng
                                </button>
                            </div>
                        </div>

                        <div class="border-t border-gray-200 pt-4 mt-4">
                            <div class="flex justify-between items-end mb-1">
                                <span class="text-base font-bold text-gray-900">Tổng cộng</span>
                                <span class="text-2xl font-bold text-emerald-600">@TotalAmount.ToString("N0") ₫</span>
                            </div>
                            <p class="text-xs text-right text-gray-500">(Đã bao gồm VAT)</p>
                        </div>
                    </div>

                    <button @onclick="ProceedToCheckout" disabled="@(cartItems.Count == 0)"
                            class="w-full mt-6 bg-emerald-600 hover:bg-emerald-400 disabled:bg-gray-400 disabled:cursor-not-allowed text-white font-semibold py-4 rounded-xl shadow-lg shadow-blue-500/30 transition-all transform hover:scale-[1.02] active:scale-[0.98] flex justify-center items-center gap-2">
                        <span>Tiến hành thanh toán</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </button>

                    @* Icons bảo mật *@
                    <div class="mt-6 flex items-center justify-center gap-6 text-gray-400">
                        @* Xe tải *@
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                        </svg>
                        @* Khiên *@
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        @* Thẻ *@
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* Style tùy chọn để thanh cuộn đẹp hơn (giống MacOS/Mobile) *@
<style>
    /* Ẩn thanh cuộn mặc định xấu xí */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #e5e7eb; /* gray-200 */
        border-radius: 20px;
    }
    .custom-scrollbar:hover::-webkit-scrollbar-thumb {
        background-color: #d1d5db; /* gray-300 */
    }
</style>

@code {
    private List<CartItem> cartItems = new();

    private decimal SubTotal => cartItems.Sum(x => x.Price * x.Quantity);
    private decimal Discount => 0;
    private decimal TotalAmount => SubTotal - Discount;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += RefreshCart;
        cartItems = await CartService.GetCart();
    }

    private async void RefreshCart()
    {
        cartItems = await CartService.GetCart();
        await InvokeAsync(StateHasChanged);
    }

    private async Task IncreaseQty(CartItem item)
    {
        item.Quantity++;
        await CartService.UpdateQuantity(item.ProductId, item.Quantity);
        cartItems = await CartService.GetCart();
    }

    private async Task DecreaseQty(CartItem item)
    {
        if (item.Quantity > 1)
        {
            item.Quantity--;
            await CartService.UpdateQuantity(item.ProductId, item.Quantity);
        }
        else
        {
            await CartService.RemoveItem(item.ProductId);
        }

        cartItems = await CartService.GetCart();
    }

    private async Task RemoveItem(CartItem item)
    {
        await CartService.RemoveItem(item.ProductId);
        cartItems = await CartService.GetCart();
    }

    private void ProceedToCheckout()
    {
        Navigation.NavigateTo("/checkout");
    }

    public void Dispose()
    {
        CartService.OnChange -= RefreshCart;
    }

    private async Task SetFakeCart()
    {
        var fake = new List<CartItem>
        {
            new() {
                ProductId = 1,
                ProductName = "Test sản phẩm 1",
                Price = 100000,
                Quantity = 1,
                ProductImg = "https://via.placeholder.com/150"
            },
            new() {
                ProductId = 2,
                ProductName = "Test sản phẩm 2",
                Price = 200000,
                Quantity = 3,
                ProductImg = "https://via.placeholder.com/150"
            },
    new() {
                ProductId = 1,
                ProductName = "Test sản phẩm 1",
                Price = 100000,
                Quantity = 1
            },
            new() {
                ProductId = 2,
                ProductName = "Test sản phẩm 2",
                Price = 200000,
                Quantity = 3
            },new() {
                ProductId = 1,
                ProductName = "Test sản phẩm 1",
                Price = 100000,
                Quantity = 1
            },
            new() {
                ProductId = 2,
                ProductName = "Test sản phẩm 2",
                Price = 200000,
                Quantity = 3
            }
        };

        await LocalStorage.SetItemAsync("shopping_cart", fake);
    }

    
}